	<array>
		<string>Fraunces_72pt-Regular.ttf</string>
		<string>Fraunces_72pt-SemiBold.ttf</string>
		<string>Fraunces_72pt-Bold.ttf</string>
		<string>Karla-Regular.ttf</string>
		<string>Karla-Medium.ttf</string>
		<string>Karla-SemiBold.ttf</string>
		<string>Karla-Bold.ttf</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>New Things Tracker needs your location to suggest firsts based on places you visit.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>New Things Tracker uses background location to detect arrivals and departures so it can suggest new firsts even when the app is closed.</string>
	<key>NSPhotoLibraryUsageDescription</key>
